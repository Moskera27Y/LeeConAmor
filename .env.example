# URL pública de Vercel (la usa iniciar-leeconamor.bat para abrir tu página publicada)
# DEPLOY_URL=https://tu-app.vercel.app
# Voz clonada en la nube (Hugging Face Space, gratis y sin cuota).
# Crea el Space con la carpeta voz-clon-space y pega aquí su URL:
# CLON_URL=https://tu-usuario-voz-leo.hf.space
# Nube Supabase (opcional: sin esto, todo se guarda en el dispositivo)
# Crea proyecto gratis en https://supabase.com y pega aquí:
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-clave-anon
# En Supabase: Authentication > Providers > activa Email y Google.
# Pega supabase/schema.sql en el SQL Editor para crear las tablas.
# Voz de Léo (Gemini TTS, voces femeninas gratis):
#   Crea tu clave gratis en https://aistudio.google.com (sin tarjeta)
#   Puedes poner VARIAS claves separadas por coma: si una se queda sin cuota
#   usa la siguiente automáticamente (ej. claves de 2 cuentas de Google)
GEMINI_API_KEY=pega-aqui-tu-clave-de-google-ai-studio
# GEMINI_TTS_MODEL=gemini-2.5-flash-lite-preview-tts  (opcional)
# Transcripción (fallback automático: primero whisperapi, si falla usa openai):
WHISPER_PROVIDER=auto
WHISPER_API_KEY=pega-aqui-tu-clave-de-whisper-api.com
OPENAI_API_KEY=pega-aqui-tu-clave-de-openai
# Sin keys la app sigue funcionando con voz y oído básicos del navegador.
# Si expusiste una clave en un chat, rotala en el dashboard del proveedor.
