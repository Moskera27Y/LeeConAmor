{
  "name": "leer-con-amor",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "api:dev": "node server/local-transcribe-server.cjs",
    "clon:servidor": "server\\voz-clon\\venv\\Scripts\\python server\\voz-clon\\clonar.py",
    "voz:clon": "node server/precache-clon.cjs",
    "voz:contar": "node server/precache-clon.cjs --contar",
    "voz:nombres": "node server/precache-nombres.cjs",
    "todo": "concurrently -n api,web -c magenta,cyan \"npm:api:dev\" \"npm:dev\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:trazo": "node server/test-trazo.cjs",
    "test:voz": "node server/test-voz.cjs",
    "test:unit": "vitest run",
    "test": "node server/test-trazo.cjs && node server/test-voz.cjs --sin-audio && vitest run",
    "verify": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "openai": "^7.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/multer": "^2.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "formidable": "^3.5.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
